# ============================================================
# Apollo Restaurant OS — Environment Configuration
# ============================================================
# Copy this file to .env and fill in appropriate values.
# NEVER commit .env to source control.
# ============================================================

# --- General ---
NODE_ENV=development
LOG_LEVEL=debug

# --- API Server ---
API_PORT=3001
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:5173

# --- Database: PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=apollo
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=apollo_restaurant
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Database: Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_in_production

# --- Database: Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- AI Services ---
AI_SERVICE_URL=http://localhost:8000

# --- LLM Providers (configure at least one) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Auth (placeholder — not yet implemented) ---
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Encryption ---
ENCRYPTION_KEY=replace_with_32_byte_hex_key

