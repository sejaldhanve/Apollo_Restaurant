    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@apollo/config": "workspace:*",
    "@apollo/shared-types": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.1",
    "@tanstack/react-query": "^5.80.6",
    "zustand": "^5.0.5",
    "react-hook-form": "^7.56.4",
    "@hookform/resolvers": "^5.0.1",
    "zod": "^3.25.56",
    "socket.io-client": "^4.8.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.513.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "vite": "^6.3.5",
    "typescript": "^5.8.3",
    "tailwindcss": "^4.1.8",
