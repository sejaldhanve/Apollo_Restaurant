{
  "name": "apollo-restaurant-os",
  "version": "0.1.0",
  "private": true,
  "description": "Apollo Restaurant OS — AI-Native Autonomous Restaurant Operating System",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev:web": "pnpm --filter @apollo/web dev",
    "dev:api": "pnpm --filter @apollo/api dev",
    "build:web": "pnpm --filter @apollo/web build",
    "build:api": "pnpm --filter @apollo/api build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm run build:packages && pnpm run build:api && pnpm run build:web",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "pnpm --filter @apollo/tests-integration test",
    "test:e2e": "pnpm --filter @apollo/tests-e2e test",
    "clean": "pnpm -r run clean",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "prepare": "echo 'Hooks ready'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "typescript": "^5.9.3"
  }
}
