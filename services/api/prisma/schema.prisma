// Apollo Restaurant OS — Primary Relational Schema
// Multi-tenancy and core organizational domain

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum OrgStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  TEMPORARILY_CLOSED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum RoleScope {
  ORGANIZATION
  LOCATION
}

enum StationType {
  KITCHEN
  BAR
  GRILL
  SALAD
  PIZZA
  EXPO
  DESSERT
}

// ─── Core Tenant Models ───────────────────────────────────────────────────────

/// Represents an enterprise restaurant business or franchise operator.
model Organization {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  legalName String?
  taxId     String?
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  locations              Location[]
  members                OrganizationMembership[]
  roles                  Role[]
  auditLogs              AuditLog[]
  kitchenStations        KitchenStation[]
  taxRates               TaxRate[]
  menus                  Menu[]
  menuCategories         MenuCategory[]
  menuItems              MenuItem[]
  modifierGroups         ModifierGroup[]
  menuItemModifierGroups MenuItemModifierGroup[]
  modifierOptions        ModifierOption[]
  locationMenuOverrides  LocationMenuOverride[]
  diningAreas            DiningArea[]
  tables                 Table[]
  tableSessions          TableSession[]
  orders                 Order[]
  orderItems             OrderItem[]
  orderItemModifiers     OrderItemModifier[]
  payments               Payment[]

  @@map("organizations")
}

/// Represents a distinct physical restaurant unit or cloud kitchen location.
model Location {
  id           String         @id @default(uuid())
  organizationId String
  name         String
  code         String
  timezone     String         @default("UTC")
  currency     String         @default("USD")
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String         @default("US")
  status       LocationStatus @default(ACTIVE)
  address      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationMembers LocationMembership[]
  kitchenStations KitchenStation[]
  menuOverrides   LocationMenuOverride[]
  diningAreas     DiningArea[]
  tables          Table[]
  tableSessions   TableSession[]
  orders          Order[]
  payments        Payment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("locations")
}

// ─── User & Auth Models ───────────────────────────────────────────────────────

/// Global user account — NOT tenant-scoped.
model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified Boolean    @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships         OrganizationMembership[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  tableSessions       TableSession[]
  assignedDiningAreas DiningArea[]             @relation("DiningAreaServer")
  assignedTables      Table[]                  @relation("TableServer")
  orders              Order[]                  @relation("OrderServer")

  @@map("users")
}

/// Links a user to an organization with a role. Tenant-scoped.
model OrganizationMembership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  roleId         String
  status         MembershipStatus @default(INVITED)
  invitedAt      DateTime         @default(now())
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  locationMemberships LocationMembership[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

/// Grants an org member access to a specific location. Tenant-scoped.
model LocationMembership {
  id                       String   @id @default(uuid())
  organizationMembershipId String
  locationId               String
  organizationId           String // denormalized for RLS
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organizationMembership OrganizationMembership @relation(fields: [organizationMembershipId], references: [id], onDelete: Cascade)
  location               Location               @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([organizationMembershipId, locationId])
  @@index([organizationId])
  @@map("location_memberships")
}

// ─── RBAC Models ──────────────────────────────────────────────────────────────

/// A named role scoped to an organization. Tenant-scoped.
model Role {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean   @default(false)
  scope          RoleScope @default(ORGANIZATION)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

/// Global permission definition — NOT tenant-scoped.
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

/// Maps a permission to a role. Tenant-scoped (denormalized orgId for RLS).
model RolePermission {
  id             String   @id @default(uuid())
  roleId         String
  permissionId   String
  organizationId String // denormalized for RLS
  createdAt      DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([organizationId])
  @@map("role_permissions")
}

// ─── Token Management ─────────────────────────────────────────────────────────

/// Refresh token for JWT rotation. NOT tenant-scoped; secured by tokenHash.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  family            String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

/// Records actions for compliance and debugging. Tenant-scoped.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  ipAddress      String?
  requestId      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

// ─── Phase 2 — Module 1: Restaurant Configuration & Menu Domain ───────────────

/// Represents a distinct food or beverage preparation station in a restaurant kitchen.
model KitchenStation {
  id             String      @id @default(uuid())
  organizationId String
  locationId     String
  name           String
  code           String
  type           StationType @default(KITCHEN)
  isExpo         Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
  orderItems   OrderItem[]

  @@unique([locationId, code])
  @@index([organizationId])
  @@map("kitchen_stations")
}

/// Represents tax policies configured for an organization and assigned to items.
model TaxRate {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  rateBasisPoints Int      // e.g. 825 = 8.25%
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@index([organizationId])
  @@map("tax_rates")
}

/// Represents a full menu offering (e.g. Dinner Menu, Lunch, Happy Hour).
model Menu {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  schedule       Json?    // e.g. {"days": [1,2,3,4,5], "start": "17:00", "end": "22:00"}
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories   MenuCategory[]

  @@index([organizationId])
  @@map("menus")
}

/// Represents a group of menu items (e.g. Appetizers, Steaks, Wines).
model MenuCategory {
  id             String   @id @default(uuid())
  organizationId String
  menuId         String
  name           String
  description    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menu         Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@index([organizationId])
  @@index([menuId, sortOrder])
  @@map("menu_categories")
}

/// Represents an individual dish or beverage on the menu.
model MenuItem {
  id               String   @id @default(uuid())
  organizationId   String
  categoryId       String
  kitchenStationId String?
  taxRateId        String?
  name             String
  description      String?
  sku              String?
  basePriceCents   Int      // Price in integer cents
  isAvailable      Boolean  @default(true) // 86 stock status
  prepTimeMinutes  Int      @default(15)
  calories         Int?
  allergens        String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  kitchenStation KitchenStation?         @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)
  taxRate        TaxRate?                @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  modifierGroups MenuItemModifierGroup[]
  overrides      LocationMenuOverride[]
  orderItems     OrderItem[]

  @@index([organizationId])
  @@index([categoryId])
  @@map("menu_items")
}

/// Represents a group of customizable options (e.g. Meat Temperature, Salad Dressing).
model ModifierGroup {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  minSelections  Int      @default(0)
  maxSelections  Int      @default(1)
  isRequired     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  options      ModifierOption[]
  menuItems    MenuItemModifierGroup[]
  orderItemModifiers OrderItemModifier[]

  @@index([organizationId])
  @@map("modifier_groups")
}

/// Links modifier groups to specific menu items with customizable sort ordering.
model MenuItemModifierGroup {
  id              String @id @default(uuid())
  organizationId  String
  menuItemId      String
  modifierGroupId String
  sortOrder       Int    @default(0)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([organizationId])
  @@map("menu_item_modifier_groups")
}

/// Represents an individual option within a modifier group (e.g. Medium Rare, Ranch, Gluten-Free Bun).
model ModifierOption {
  id              String   @id @default(uuid())
  organizationId  String
  modifierGroupId String
  name            String
  priceDeltaCents Int      @default(0) // Additional or discounted cost in cents
  isAvailable     Boolean  @default(true)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@index([organizationId])
  @@index([modifierGroupId])
  @@map("modifier_options")
}

/// Represents location-specific overrides for pricing or 86 availability.
model LocationMenuOverride {
  id                 String   @id @default(uuid())
  organizationId     String
  locationId         String
  menuItemId         String
  overridePriceCents Int?
  isAvailable        Boolean? // Location-level 86 status
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  menuItem     MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([locationId, menuItemId])
  @@index([organizationId])
  @@map("location_menu_overrides")
}

// ─── FoH Floor Plan & Table Management Models ───────────────────────────────

enum TableShape {
  RECTANGLE
  ROUND
  SQUARE
  BOOTH
  BAR_STOOL
}

enum TableStatus {
  AVAILABLE
  SEATED
  ORDERED
  SERVED
  PAYMENT_PENDING
  DIRTY
  RESERVED
  BLOCKED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
}

/// A physical section or dining room within a location. Tenant-scoped.
model DiningArea {
  id             String   @id @default(uuid())
  organizationId String
  locationId     String
  name           String   // e.g. "Main Dining Room", "Patio", "Bar"
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  assignedServerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  assignedServer User?        @relation("DiningAreaServer", fields: [assignedServerId], references: [id], onDelete: SetNull)
  tables         Table[]

  @@unique([locationId, name])
  @@index([organizationId])
  @@index([assignedServerId])
  @@map("dining_areas")
}

/// A physical table or seating unit on the visual floor plan. Tenant-scoped.
model Table {
  id             String      @id @default(uuid())
  organizationId String
  locationId     String
  diningAreaId   String
  tableNumber    String
  shape          TableShape  @default(RECTANGLE)
  minCovers      Int         @default(1)
  maxCovers      Int         @default(4)
  posX           Float       @default(0) // Visual 2D X coordinate
  posY           Float       @default(0) // Visual 2D Y coordinate
  width          Float       @default(100)
  height         Float       @default(100)
  rotation       Float       @default(0)
  status           TableStatus @default(AVAILABLE)
  isActive         Boolean     @default(true)
  assignedServerId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  diningArea     DiningArea     @relation(fields: [diningAreaId], references: [id], onDelete: Cascade)
  assignedServer User?          @relation("TableServer", fields: [assignedServerId], references: [id], onDelete: SetNull)
  sessions       TableSession[]
  orders         Order[]

  @@unique([locationId, tableNumber])
  @@index([organizationId])
  @@index([locationId, status])
  @@index([assignedServerId])
  @@map("tables")
}

/// An active or historical seating session at a table. Tenant-scoped.
model TableSession {
  id             String        @id @default(uuid())
  organizationId String
  locationId     String
  tableId        String
  serverUserId   String?
  guestCount     Int           @default(2)
  seatedAt       DateTime      @default(now())
  closedAt       DateTime?
  status         SessionStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  table        Table        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  server       User?        @relation(fields: [serverUserId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@index([organizationId])
  @@index([locationId, status])
  @@map("table_sessions")
}

// ─── Phase 2 — Module 4: POS & Order Management Domain ───────────────────────

enum OrderStatus {
  DRAFT
  SUBMITTED
  IN_PREPARATION
  READY
  SERVED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  IN_PREPARATION
  READY
  SERVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

/// A dining table or takeout order. Tenant-scoped.
model Order {
  id             String        @id @default(uuid())
  organizationId String
  locationId     String
  tableId        String?
  tableSessionId String?
  serverUserId   String?
  orderNumber    String        // e.g. "ORD-101"
  status         OrderStatus   @default(DRAFT)
  paymentStatus  PaymentStatus @default(UNPAID)
  subtotalCents  Int           @default(0)
  taxCents       Int           @default(0)
  totalCents     Int           @default(0)
  currency       String        @default("USD")
  guestCount     Int           @default(1)
  notes          String?
  idempotencyKey String?
  submittedAt    DateTime?
  preparedAt     DateTime?
  servedAt       DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  table        Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSession TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  server       User?         @relation("OrderServer", fields: [serverUserId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([locationId, status])
  @@index([tableId])
  @@index([tableSessionId])
  @@index([serverUserId])
  @@map("orders")
}

/// An individual line item on an order with snapshotted prices. Tenant-scoped.
model OrderItem {
  id                  String          @id @default(uuid())
  organizationId      String
  orderId             String
  menuItemId          String
  kitchenStationId    String?
  name                String          // Snapshot of item name at order time
  basePriceCents      Int             // Snapshot of item price in integer cents
  quantity            Int             @default(1)
  subtotalCents       Int             // (basePrice + modifiers) * quantity
  taxRateBasisPoints  Int             @default(0)
  taxCents            Int             @default(0)
  totalCents          Int             // subtotal + tax
  status              OrderItemStatus @default(PENDING)
  specialInstructions String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem       MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  kitchenStation KitchenStation?     @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)
  modifiers      OrderItemModifier[]

  @@index([organizationId])
  @@index([orderId])
  @@index([kitchenStationId, status])
  @@map("order_items")
}

/// Modifiers applied to an order line item. Tenant-scoped.
model OrderItemModifier {
  id              String   @id @default(uuid())
  organizationId  String
  orderItemId     String
  modifierGroupId String?
  modifierOptionId String?
  groupName       String   // Snapshot of modifier group name
  optionName      String   // Snapshot of option name
  priceDeltaCents Int      @default(0) // Snapshot of price delta
  createdAt       DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierGroup  ModifierGroup?  @relation(fields: [modifierGroupId], references: [id], onDelete: SetNull)
  modifierOption ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([orderItemId])
  @@map("order_item_modifiers")
}

/// Payment record foundation for POS check settlement. Tenant-scoped.
model Payment {
  id             String        @id @default(uuid())
  organizationId String
  locationId     String
  orderId        String
  amountCents    Int
  currency       String        @default("USD")
  status         PaymentStatus @default(UNPAID)
  paymentMethod  String?       // "CASH", "CARD", etc.
  referenceId    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([orderId])
  @@map("payments")
}

